// See https://go.microsoft.com/fwlink/?LinkId=733558
// for the documentation about the tasks.json format
{
  "version": "2.0.0",
  "tasks": [
    {
      // Used by F5 (see launch.json). A one-shot full build (tsup + vite + i18n),
      // which exits when done so the debugger launches reliably. Fast (~a few s).
      "type": "npm",
      "script": "build",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "silent",
        "clear": true
      }
    },
    {
      // Optional watch build for iterative development:
      // "Terminal > Run Task > npm: dev" (or `yarn dev` in a terminal).
      // Rebuilds on change; reload the Extension Development Host to pick up changes.
      "type": "npm",
      "script": "dev",
      "isBackground": true,
      "presentation": {
        "reveal": "never"
      },
      "problemMatcher": {
        "owner": "tsup",
        "pattern": {
          "regexp": "^([^\\s].*)\\((\\d+),(\\d+)\\):\\s+(error|warning)\\s+(TS\\d+):\\s+(.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 4,
          "code": 5,
          "message": 6
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Build start",
          "endsPattern": "Build success"
        }
      },
      "group": "build"
    }
  ]
}
